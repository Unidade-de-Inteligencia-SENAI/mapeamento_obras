# ── Azure Blob Storage ──────────────────────────────────────────────────
# Opção A (mais simples): connection string completa.
# Encontrada no Portal Azure em: Storage Account > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=""

# Opção B: nome da conta + chave, como alternativa à connection string acima.
# Preencha OU a opção A OU a B — não precisa das duas.
AZURE_STORAGE_ACCOUNT_NAME = ""
AZURE_STORAGE_ACCOUNT_KEY  = ""

AZURE_STORAGE_CONTAINER    = ""

# Prefixo (pasta virtual) opcional dentro do container. Pode deixar em branco.
AZURE_BLOB_PREFIX_pncp = "/obras/pncp"

#INTEGRAçÂO TCE
AZURE_BLOB_PREFIX_tce="/obras/tce"

#INTEGRAçÂO seade
AZURE_BLOB_PREFIX_seade="/obras/seade"

#INTEGRAçÂO sissel
AZURE_BLOB_PREFIX_sissel="/obras/sissel"

#INTEGRAçÂO sigmine
AZURE_BLOB_PREFIX_sigmine="/obras/sigmine"
