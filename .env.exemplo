# ── Azure Blob Storage ──────────────────────────────────────────────────
# Opção A (mais simples): connection string completa.
# Encontrada no Portal Azure em: Storage Account > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=""

# Opção B: nome da conta + chave, como alternativa à connection string acima.
# Preencha OU a opção A OU a B — não precisa das duas.
AZURE_STORAGE_ACCOUNT_NAME = ""
AZURE_STORAGE_ACCOUNT_KEY  = ""

AZURE_STORAGE_CONTAINER    = ""
AZURE_BLOB_PREFIX_pncp     = ""